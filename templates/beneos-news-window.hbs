<section class="beneos-news-window-content">
  <div class="beneos-news-box">
    {{{content}}}
    <hr/>
    <p class="beneos-news-date"><strong>{{dateLabel}}:</strong> {{formattedDate}}</p>
  </div>
  <footer class="beneos-news-footer">
    <button type="button" class="beneos-news-close-btn" data-action="closeNews">
      <i class="fas fa-check"></i> {{closeLabel}}
    </button>
  </footer>
</section>
