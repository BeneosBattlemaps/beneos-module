{{!
  Der Offline-Vorrat. Zuerst der Stand, dann die Frist, dann die Liste:
  in dieser Reihenfolge, weil ein Spielleiter zuerst wissen will, ob noch
  Platz ist, und erst danach, was drin liegt.

  SEIT DEM 29.10.2026 UEBERSETZT. Bis dahin standen hier deutsche Festtexte,
  in einem Produkt mit dreizehn Sprachdateien. Wer eine Zeile aendert, aendert
  den Schluessel in `lang/en.json` und zieht die zwoelf anderen nach.

  Drei Texte werden bewusst WIEDERVERWENDET statt neu geschrieben, weil es
  dieselbe Aussage ist und zwei Formulierungen fuer eine Sache auseinander
  laufen: `FetchNow`, `MissingWhy` und `Keep`.
}}
<div class="beneos-ov">

  <section class="beneos-ov-stand">
    <div class="beneos-ov-zahlen">
      <span class="beneos-ov-gross">{{belegtGB}}</span>
      <span class="beneos-ov-klein">{{localize "BENEOS.Stream.Offline.Panel.UsedOf" limit=grenzeGB}}</span>
      <span class="beneos-ov-rechts">{{localize "BENEOS.Stream.Offline.Panel.Maps" n=anzahl}}</span>
    </div>
    <div class="beneos-ov-balken" role="img"
         aria-label="{{localize "BENEOS.Stream.Offline.Panel.BarLabel" used=belegtGB limit=grenzeGB}}">
      <span style="width: {{anteil}}%"></span>
    </div>
  </section>

  {{!-- Die Dokumentation, seit dem 29.10.2026. Sie steht direkt unter der
        Leiste, weil sie die Leiste erklaert: wer hier landet, hat meist genau
        auf sie geklickt.

        `dokuOffen` kommt vom Aufrufer. Der Klick auf die Speicherleiste im
        Maps-Reiter schlaegt sie auf, der Weg ueber Foundrys Einstellungen
        laesst sie zu, denn dort sucht niemand eine Erklaerung.

        Die Reihenfolge der Absaetze ist Absicht und folgt der Betreibervorgabe:
        erst was die Leiste ist, dann was Streaming bringt, und der
        Offline-Vorrat zuletzt, weil die meisten ihn nie brauchen. Stuende er
        vorn, lernte jeder Leser zuerst eine Funktion, die er nicht benoetigt. --}}
  <details class="beneos-ov-doku" {{#if dokuOffen}}open{{/if}}>
    <summary>{{localize "BENEOS.Stream.Doku.Summary"}}</summary>
    <p><strong>{{localize "BENEOS.Stream.Doku.BarLead"}}</strong>
       {{localize "BENEOS.Stream.Doku.BarBody"}}</p>
    <p><strong>{{localize "BENEOS.Stream.Doku.HowLead"}}</strong>
       {{localize "BENEOS.Stream.Doku.HowBody"}}</p>
    <p><strong>{{localize "BENEOS.Stream.Doku.SpeedLead"}}</strong>
       {{localize "BENEOS.Stream.Doku.SpeedBody"}}</p>
    <p><strong>{{localize "BENEOS.Stream.Doku.HostLead"}}</strong>
       {{localize "BENEOS.Stream.Doku.HostBody"}}</p>
    <p><strong>{{localize "BENEOS.Stream.Doku.OfflineLead"}}</strong>
       {{localize "BENEOS.Stream.Doku.OfflineBody"
          label=(localize "BENEOS.Stream.Offline.Keep")}}</p>
    <p><strong>{{localize "BENEOS.Stream.Doku.DropLead"}}</strong>
       {{localize "BENEOS.Stream.Doku.DropBody"}}</p>
  </details>

  <section class="beneos-ov-frist {{#if fristAbgelaufen}}ist-abgelaufen{{else}}{{#if fristKnapp}}ist-knapp{{/if}}{{/if}}">
    {{#if fristNie}}
      <p><strong>{{localize "BENEOS.Stream.Offline.Panel.NeverLead"}}</strong>
         {{localize "BENEOS.Stream.Offline.Panel.NeverBody"}}</p>
    {{else if fristAbgelaufen}}
      <p><strong>{{localize "BENEOS.Stream.Offline.Panel.ExpiredLead"}}</strong>
         {{localize "BENEOS.Stream.Offline.Panel.ExpiredBody" days=verfallTage}}</p>
    {{else}}
      <p><strong>{{localize "BENEOS.Stream.Offline.Panel.LeftLead" days=fristTage}}</strong>
         {{localize "BENEOS.Stream.Offline.Panel.LeftBody" days=verfallTage}}</p>
    {{/if}}
  </section>

  {{#if fehlend}}
  <section class="beneos-ov-fehlend">
    <p><strong>{{localize "BENEOS.Stream.Offline.Panel.MissingLead" n=fehlend mb=fehlendMB}}</strong>
       {{localize "BENEOS.Stream.Offline.MissingWhy"}}</p>
    <button type="button" data-action="repairMissing">
      <i class="fa-solid fa-rotate"></i> {{localize "BENEOS.Stream.Offline.FetchNow"}}
    </button>
  </section>
  {{/if}}

  {{#if leer}}
    <section class="beneos-ov-leer">
      <p>{{localize "BENEOS.Stream.Offline.Panel.EmptyLead"}}</p>
      <p class="beneos-ov-hinweis">{{localize "BENEOS.Stream.Offline.Panel.EmptyHint"
         label=(localize "BENEOS.Stream.Offline.Keep")}}</p>
    </section>
  {{else}}
    <ol class="beneos-ov-liste">
      {{#each karten}}
      <li class="{{#if this.fehlt}}fehlt{{/if}}">
        <span class="beneos-ov-name">
          {{this.name}}
          {{#if this.fehlt}}<span class="beneos-ov-marke">{{localize "BENEOS.Stream.Offline.Panel.MissingMark"}}</span>{{/if}}
        </span>
        <span class="beneos-ov-groesse">{{this.mb}} MB</span>
        <button type="button" class="beneos-ov-weg" data-action="releaseMap"
                data-release="{{this.release}}" data-variant="{{this.variant}}"
                data-karte="{{this.karte}}"
                aria-label="{{localize "BENEOS.Stream.Offline.Panel.StreamAgain" name=this.name}}">
          <i class="fa-regular fa-cloud"></i>
        </button>
      </li>
      {{/each}}
    </ol>
  {{/if}}

  <footer class="beneos-ov-fuss">
    <p>{{localize "BENEOS.Stream.Offline.Panel.Footer" total=browserGB used=browserBelegtGB}}</p>
  </footer>

</div>
