{{!-- Beneos Cloud V2 — settings modal.
     Surfaces the most-used module options and a small set of action
     buttons inside the same V2 design language as the cloud window.
     Built on the existing .beneos-cloud-app token system + .bc-* utility
     classes so visual consistency is automatic.

     Initial sections (further sections can be appended without changing
     the layout grammar):
       - Setup Tour            (button → BeneosStartSetupTour)
       - Automatic Death Token (toggle → beneos-death-management)
       - Show DM Navigation    (toggle → showNavToPlayers)
       - Asset Check           (button → scanAllScenes) --}}
<section class="beneos-cloud-app bc-settings-app">

  <header class="bc-sidebar-group bc-settings-header">
    <h2 class="bc-sidebar-heading bc-settings-title">{{localize "BENEOS.Cloud.Settings.Title"}}</h2>
  </header>

  <div class="bc-settings-rows">

    {{!-- Account — state-aware Login / Disconnect row. Shows
         disconnect when signed in (public-Foundry users need a fast
         logout path), sign-in CTA when signed out. --}}
    <div class="bc-settings-row bc-settings-row-account">
      <div class="bc-settings-row-meta">
        <div class="bc-settings-row-label">{{localize "BENEOS.Cloud.Settings.Account.Header"}}</div>
        {{#if isCloudLoggedIn}}
          <div class="bc-settings-row-hint">
            <span class="bc-account-chip bc-chip-success">
              <i class="fa-solid fa-circle-check"></i>
              <span>{{localize "BENEOS.Cloud.Settings.Account.LoggedInAs"}}</span>
            </span>
            {{localize "BENEOS.Cloud.Settings.Account.DisconnectHint"}}
          </div>
        {{else}}
          <div class="bc-settings-row-hint">
            <span class="bc-account-chip bc-chip-neutral">
              <i class="fa-solid fa-cloud-slash"></i>
              <span>{{localize "BENEOS.Cloud.Settings.Account.NotConnected"}}</span>
            </span>
            {{localize "BENEOS.Cloud.Settings.Account.SignInHint"}}
          </div>
        {{/if}}
      </div>
      <div class="bc-settings-row-control">
        {{#if isCloudLoggedIn}}
          <button type="button"
                  class="bc-card-button bc-card-button-danger"
                  data-action="disconnectAccount">
            <i class="fa-solid fa-right-from-bracket"></i>
            <span>{{localize "BENEOS.Cloud.Settings.Account.Disconnect"}}</span>
          </button>
        {{else}}
          <button type="button"
                  class="bc-card-button bc-card-button-primary"
                  data-action="openLogin">
            <i class="fa-solid fa-right-to-bracket"></i>
            <span>{{localize "BENEOS.Cloud.Settings.Account.SignIn"}}</span>
          </button>
        {{/if}}
      </div>
    </div>

    {{!-- Setup Tour — action row. The handler instantiates the existing
         BeneosStartSetupTour FormApplication. --}}
    <div class="bc-settings-row">
      <div class="bc-settings-row-meta">
        <div class="bc-settings-row-label">{{localize "BENEOS.Cloud.Settings.SetupTour.Label"}}</div>
        <div class="bc-settings-row-hint">{{localize "BENEOS.Cloud.Settings.SetupTour.Hint"}}</div>
      </div>
      <div class="bc-settings-row-control">
        <button type="button"
                class="bc-card-button bc-card-button-primary"
                data-action="startSetupTour">
          <i class="fa-solid fa-play"></i>
          <span>{{localize "BENEOS.Cloud.Settings.SetupTour.Action"}}</span>
        </button>
      </div>
    </div>

    {{!-- Asset Repair — action row that opens BeneosRepairMenuApp. --}}
    <div class="bc-settings-row">
      <div class="bc-settings-row-meta">
        <div class="bc-settings-row-label">{{localize "BENEOS.Cloud.Settings.AssetRepair.Label"}}</div>
        <div class="bc-settings-row-hint">{{localize "BENEOS.Cloud.Settings.AssetRepair.Hint"}}</div>
      </div>
      <div class="bc-settings-row-control">
        <button type="button"
                class="bc-card-button bc-card-button-primary"
                data-action="openAssetRepair">
          <i class="fa-solid fa-wrench"></i>
          <span>{{localize "BENEOS.Cloud.Settings.AssetRepair.Action"}}</span>
        </button>
      </div>
    </div>

    {{!-- Death Tokens — toggle row bound to beneos-death-management. --}}
    <div class="bc-settings-row">
      <div class="bc-settings-row-meta">
        <div class="bc-settings-row-label">{{localize "BENEOS.Cloud.Settings.DeathTokens.Label"}}</div>
        <div class="bc-settings-row-hint">{{localize "BENEOS.Cloud.Settings.DeathTokens.Hint"}}</div>
      </div>
      <div class="bc-settings-row-control">
        <span class="bc-settings-saved" aria-hidden="true">
          <i class="fa-solid fa-check"></i>
          <span>{{localize "BENEOS.Cloud.Settings.Saved"}}</span>
        </span>
        <label class="bc-checkbox-row bc-settings-toggle">
          <input type="checkbox"
                 class="bc-checkbox"
                 data-setting-key="beneos-death-management"
                 {{#if deathTokensEnabled}}checked{{/if}} />
        </label>
      </div>
    </div>

    {{!-- Show DM Navigation to Players — toggle row bound to showNavToPlayers. --}}
    <div class="bc-settings-row">
      <div class="bc-settings-row-meta">
        <div class="bc-settings-row-label">{{localize "BENEOS.Cloud.Settings.ShowNav.Label"}}</div>
        <div class="bc-settings-row-hint">{{localize "BENEOS.Cloud.Settings.ShowNav.Hint"}}</div>
      </div>
      <div class="bc-settings-row-control">
        <span class="bc-settings-saved" aria-hidden="true">
          <i class="fa-solid fa-check"></i>
          <span>{{localize "BENEOS.Cloud.Settings.Saved"}}</span>
        </span>
        <label class="bc-checkbox-row bc-settings-toggle">
          <input type="checkbox"
                 class="bc-checkbox"
                 data-setting-key="showNavToPlayers"
                 {{#if showNavEnabled}}checked{{/if}} />
        </label>
      </div>
    </div>

    {{!-- Asset Watcher — toggle row. Mirrors the existing
         `assetWatcherEnabled` setting registered in beneos-asset-watcher.js;
         when on, the canvasReady hook auto-scans each opened scene and
         pops a single dialog if anything is missing. --}}
    <div class="bc-settings-row">
      <div class="bc-settings-row-meta">
        <div class="bc-settings-row-label">{{localize "BENEOS.Cloud.Settings.AssetCheck.Label"}}</div>
        <div class="bc-settings-row-hint">{{localize "BENEOS.Cloud.Settings.AssetCheck.Hint"}}</div>
      </div>
      <div class="bc-settings-row-control">
        <span class="bc-settings-saved" aria-hidden="true">
          <i class="fa-solid fa-check"></i>
          <span>{{localize "BENEOS.Cloud.Settings.Saved"}}</span>
        </span>
        <label class="bc-checkbox-row bc-settings-toggle">
          <input type="checkbox"
                 class="bc-checkbox"
                 data-setting-key="assetWatcherEnabled"
                 {{#if assetCheckEnabled}}checked{{/if}} />
        </label>
      </div>
    </div>

    {{#if creatorMode}}
      {{!-- Dev: Test Personas. Simulates Patreon membership states
           without an actual login — used during V2 development to
           preview the patron-aware UI in all five permutations. Only
           visible when the beneos-creator-mode setting is true. --}}
      <div class="bc-settings-row bc-settings-row-dev">
        <div class="bc-settings-row-meta">
          <div class="bc-settings-row-label">{{localize "BENEOS.Cloud.Settings.DevPersonas.Header"}}</div>
          <div class="bc-settings-row-hint">{{localize "BENEOS.Cloud.Settings.DevPersonas.Description"}}</div>
        </div>
        <div class="bc-settings-row-control bc-settings-personas">
          <button type="button" class="bc-card-button bc-card-button-primary"
                  data-action="simulatePersona" data-persona="full">
            <i class="fa-solid fa-crown"></i>
            <span>{{localize "BENEOS.Cloud.Settings.DevPersonas.FullPatron"}}</span>
          </button>
          <button type="button" class="bc-card-button"
                  data-action="simulatePersona" data-persona="tokens">
            <i class="fa-solid fa-dragon"></i>
            <span>{{localize "BENEOS.Cloud.Settings.DevPersonas.TokenOnly"}}</span>
          </button>
          <button type="button" class="bc-card-button"
                  data-action="simulatePersona" data-persona="battlemaps">
            <i class="fa-solid fa-map"></i>
            <span>{{localize "BENEOS.Cloud.Settings.DevPersonas.BattlemapOnly"}}</span>
          </button>
          <button type="button" class="bc-card-button"
                  data-action="simulatePersona" data-persona="free">
            <i class="fa-solid fa-gift"></i>
            <span>{{localize "BENEOS.Cloud.Settings.DevPersonas.Free"}}</span>
          </button>
          <button type="button" class="bc-card-button bc-card-button-danger"
                  data-action="simulatePersona" data-persona="reset">
            <i class="fa-solid fa-rotate-left"></i>
            <span>{{localize "BENEOS.Cloud.Settings.DevPersonas.Reset"}}</span>
          </button>
        </div>
      </div>
    {{/if}}

  </div>
</section>
