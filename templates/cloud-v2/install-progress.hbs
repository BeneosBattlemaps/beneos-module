{{!-- Plan §18 Phase A: Beneos-styled install progress window. Replaces
     the scene-packer wizard (gray, off-brand, asks redundant scope
     question) with our own --bc-* themed UI. Cover hero, total progress,
     phase list with status icons, current operation, close button. --}}
<section class="bc-install-progress" data-bc-install-state="{{state}}">

  {{#if coverUrl}}
    {{!-- Punkt 8b: the cover renders greyscale and fills with colour left to
         right in lockstep with the progress bar, with a thin indicator line at
         the current position. Two stacked layers of the same image + a clip. --}}
    <header class="bcip-hero">
      <div class="bcip-hero-img bcip-hero-img-base" style="background-image: url('{{coverUrl}}');"></div>
      <div class="bcip-hero-img bcip-hero-img-fill" style="background-image: url('{{coverUrl}}'); clip-path: inset(0 calc(100% - {{totalPct}}%) 0 0);"></div>
      <div class="bcip-hero-progress-line" style="left: {{totalPct}}%;"></div>
      <div class="bcip-hero-gradient"></div>
      <div class="bcip-hero-text">
        <h2 class="bcip-title">{{label}}</h2>
        {{#if subtitle}}<p class="bcip-subtitle">{{subtitle}}</p>{{/if}}
      </div>
    </header>
  {{else}}
    <header class="bcip-hero bcip-hero-plain">
      <h2 class="bcip-title">{{label}}</h2>
      {{#if subtitle}}<p class="bcip-subtitle">{{subtitle}}</p>{{/if}}
    </header>
  {{/if}}

  <div class="bcip-body">

    <div class="bcip-total">
      <div class="bcip-total-row">
        <span class="bcip-total-label">{{localize "BENEOS.Cloud.Bmap.InstallProgress.TotalProgress"}}</span>
        <span class="bcip-total-pct">{{totalPct}}%</span>
      </div>
      <div class="bcip-bar">
        <div class="bcip-bar-fill" style="width: {{totalPct}}%;"></div>
      </div>
      {{#if etaLabel}}
        <div class="bcip-eta">
          <i class="fa-regular fa-clock"></i>
          <span>{{etaLabel}}</span>
        </div>
      {{/if}}
      {{#if currentLabel}}
        <div class="bcip-current" data-tooltip="{{currentLabel}}">
          {{#if currentSpinner}}<i class="fa-solid fa-circle-notch fa-spin"></i>{{/if}}
          <span class="bcip-current-text">{{currentLabel}}</span>
        </div>
      {{/if}}
      {{#if failedLabel}}
        <div class="bcip-current" style="color:#f5c992;">
          <i class="fa-solid fa-triangle-exclamation"></i>
          <span class="bcip-current-text">{{failedLabel}}</span>
        </div>
      {{/if}}
    </div>

    <ul class="bcip-phases">
      {{#each phases as |p|}}
        <li class="bcip-phase bcip-phase-{{p.status}}">
          <span class="bcip-phase-icon">
            {{#if (eq p.status "done")}}<i class="fa-solid fa-circle-check"></i>{{/if}}
            {{#if (eq p.status "active")}}<i class="fa-solid fa-circle-notch fa-spin"></i>{{/if}}
            {{#if (eq p.status "pending")}}<i class="fa-regular fa-circle"></i>{{/if}}
            {{#if (eq p.status "skipped")}}<i class="fa-solid fa-minus"></i>{{/if}}
            {{#if (eq p.status "error")}}<i class="fa-solid fa-circle-xmark"></i>{{/if}}
          </span>
          <span class="bcip-phase-label">{{localize p.labelKey}}</span>
          {{#if p.countLabel}}<span class="bcip-phase-count">{{p.countLabel}}</span>{{/if}}
        </li>
      {{/each}}
    </ul>

    {{!-- Second install layer: Beneos creatures referenced by the scenes.
         Gold + paw when the user is an active token-patron (pulled from the
         cloud); grey + red X when not (info only). --}}
    {{#if creatureBlock}}
      <div class="bcip-creatures {{#if creatureBlock.isPatron}}bcip-creatures-patron{{else}}bcip-creatures-locked{{/if}}">
        <i class="fa-solid {{#if creatureBlock.isPatron}}fa-paw{{else}}fa-circle-xmark{{/if}}"></i>
        <span class="bcip-creatures-text">{{localize "BENEOS.Cloud.Bmap.InstallProgress.Creatures"}} <span class="bcip-creatures-suffix">{{localize "BENEOS.Cloud.Bmap.InstallProgress.CreaturesPatron"}}</span></span>
        {{#if creatureBlock.showCount}}<span class="bcip-creatures-count">{{creatureBlock.countLabel}}</span>{{/if}}
      </div>
    {{/if}}

    {{#if errorMessage}}
      <div class="bcip-error">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span>{{errorMessage}}</span>
      </div>
    {{/if}}

    {{#if hasIssues}}
      <div class="bcip-error" style="border-left-color:#f5c992;background:rgba(245,201,146,0.10);color:#f5c992;">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span>{{completedMessage}}</span>
      </div>
    {{else}}
      {{#if completedMessage}}
        <div class="bcip-success">
          <i class="fa-solid fa-circle-check"></i>
          <span>{{completedMessage}}</span>
        </div>
      {{/if}}
    {{/if}}

  </div>

  <footer class="bcip-actions">
    {{#if showReportButton}}
      <button type="button" class="bc-card-button bc-card-button-primary"
              data-action="showReport">
        <i class="fa-solid fa-clipboard-list"></i>
        {{localize "BENEOS.Cloud.Bmap.InstallProgress.ShowReport"}}
      </button>
    {{/if}}
    {{#if showOpenScenes}}
      <button type="button" class="bc-card-button bc-card-button-primary"
              data-action="openFirstScene">
        <i class="fa-solid fa-image"></i>
        {{localize "BENEOS.Cloud.Bmap.InstallProgress.OpenFirstScene"}}
      </button>
    {{/if}}
    <button type="button" class="bc-card-button{{#if closeDisabled}} bc-card-button-disabled{{/if}}"
            data-action="closeProgress"
            {{#if closeDisabled}}disabled{{/if}}>
      {{#if closeDisabled}}
        {{localize "BENEOS.Cloud.Bmap.InstallProgress.WaitForFinish"}}
      {{else}}
        {{localize "BENEOS.Cloud.Bmap.InstallProgress.Close"}}
      {{/if}}
    </button>
  </footer>

</section>
