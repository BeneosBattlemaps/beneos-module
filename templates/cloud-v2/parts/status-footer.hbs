{{!-- Beneos Cloud V2 — status footer (account chip + cloud actions).
     Patreon status / login state visualised here, lifted out of the form
     where it lived in v1.
     Wave B-9-fix-36: external-link buttons (Discord / Webshop / Patreon)
     and the module version label. The Patreon URL is tab-aware — Maps
     opens BeneosBattlemaps, every other tab opens BeneosTokens. --}}
<div class="bc-footer-region" data-bc-region="footer">
<div class="bc-install-progress" data-state="idle" aria-live="polite">
  <span class="bc-install-progress-label"></span>
  <div class="bc-install-progress-bar"><div class="bc-install-progress-fill"></div></div>
  {{!-- Stage 14: cancel the currently running bulk install. Cancel only
       finishes the asset that's already in-flight (the import pipeline is
       atomic per asset) and breaks the loop before the next one starts. --}}
  <button type="button"
          class="bc-install-progress-cancel"
          data-action="beneosCancelBulkInstall"
          aria-label="{{localize 'BENEOS.Common.Cancel'}}"
          title="{{localize 'BENEOS.Common.Cancel'}}">
    <i class="fas fa-times"></i>
  </button>
</div>
<footer class="bc-footer">
  <div class="bc-footer-left">
    {{!-- Stage 9: server-offline (beneos.cloud unreachable) takes
         absolute top priority. Distinct from the asset-DB-offline
         branch below — that's the CDN content fetch failing; this
         is the login/auth backend itself being down. The Sign-In
         button is hidden because a click would just produce a
         confusing HTTP error. Auto-recovers via the 60s probe loop
         in BeneosCloud.startServerProbeLoop. --}}
    {{#if isServerOffline}}
      <div class="bc-account-chip bc-chip-error"
           data-tooltip="{{localize 'BENEOS.Cloud.Footer.ServerOfflineTooltip'}}">
        <i class="fa-solid fa-server"></i>
        <span>{{localize "BENEOS.Cloud.Footer.ServerOffline"}}</span>
      </div>
    {{else if isOffline}}
      <div class="bc-account-chip bc-chip-warning">
        <i class="fa-solid fa-cloud-slash"></i>
        <span>{{localize "BENEOS.Cloud.Footer.Offline"}}</span>
      </div>
      {{#if isCloudLoggedIn}}
        <button type="button"
                class="bc-footer-button"
                data-action="openCloudSettings"
                data-tooltip="{{localize 'BENEOS.Cloud.Footer.AccountSettingsTooltip'}}">
          <i class="fa-solid fa-gear"></i>
          <span>{{localize "BENEOS.Cloud.Footer.AccountSettings"}}</span>
        </button>
      {{/if}}
    {{else if isCloudLoggedIn}}
      {{!-- Four valid connection states. The Beneos Cloud auto-syncs
           the user's Patreon memberships, so "not linked" is never a
           thing here — even a free account is a fully valid login.
           All four variants render in the success colour; the chip
           label spells out what kind of access the user has, and the
           tooltip explains the consequence (and softly upsells the
           campaign the user doesn't yet support). --}}
      {{#if isTokenPatron}}
        {{#if isBattlemapPatron}}
          <div class="bc-account-chip bc-chip-success" data-tooltip="{{localize 'BENEOS.Cloud.Footer.Chip.FullTooltip'}}">
            <i class="fa-solid fa-crown"></i>
            <span>{{localize "BENEOS.Cloud.Footer.Chip.Full"}}</span>
          </div>
        {{else}}
          <div class="bc-account-chip bc-chip-success" data-tooltip="{{localize 'BENEOS.Cloud.Footer.Chip.TokensTooltip'}}">
            <i class="fa-solid fa-dragon"></i>
            <span>{{localize "BENEOS.Cloud.Footer.Chip.Tokens"}}</span>
          </div>
        {{/if}}
      {{else if isBattlemapPatron}}
        <div class="bc-account-chip bc-chip-success" data-tooltip="{{localize 'BENEOS.Cloud.Footer.Chip.BattlemapsTooltip'}}">
          <i class="fa-solid fa-map"></i>
          <span>{{localize "BENEOS.Cloud.Footer.Chip.Battlemaps"}}</span>
        </div>
      {{else}}
        <div class="bc-account-chip bc-chip-success" data-tooltip="{{localize 'BENEOS.Cloud.Footer.Chip.FreeTooltip'}}">
          <i class="fa-solid fa-circle-check"></i>
          <span>{{localize "BENEOS.Cloud.Footer.Chip.Free"}}</span>
        </div>
      {{/if}}
      <button type="button"
              class="bc-footer-button"
              data-action="openCloudSettings"
              data-tooltip="{{localize 'BENEOS.Cloud.Footer.AccountSettingsTooltip'}}">
        <i class="fa-solid fa-gear"></i>
        <span>{{localize "BENEOS.Cloud.Footer.AccountSettings"}}</span>
      </button>
    {{else}}
      <div class="bc-account-chip bc-chip-neutral beneos-cloud-not-connected">
        <i class="fa-solid fa-cloud-slash"></i>
        <span>{{localize "BENEOS.Cloud.Footer.NotConnected"}}</span>
      </div>
      <button type="button"
              class="bc-footer-button bc-footer-button-primary beneos-cloud-login-button"
              data-action="openLogin">
        <i class="fa-solid fa-right-to-bracket"></i>
        <span>{{localize "BENEOS.Cloud.Footer.SignIn"}}</span>
      </button>
    {{/if}}
  </div>
  {{!-- Wave B-9-fix-45: external links pushed to the right and toned
       down so they don't compete with the Account/Login button on the
       left. Brand colour appears on hover, version moved to the title. --}}
  <div class="bc-footer-right">
    <button type="button"
            class="bc-footer-button bc-footer-link bc-footer-button-discord"
            data-action="openExternal" data-href="{{discordUrl}}"
            data-tooltip="{{localize 'BENEOS.Cloud.Footer.DiscordTooltip'}}">
      <i class="fa-brands fa-discord"></i>
      <span>{{localize "BENEOS.Cloud.Footer.Discord"}}</span>
    </button>
    <button type="button"
            class="bc-footer-button bc-footer-link bc-footer-button-webshop"
            data-action="openExternal" data-href="{{webshopUrl}}"
            data-tooltip="{{localize 'BENEOS.Cloud.Footer.WebshopTooltip'}}">
      <i class="fa-solid fa-cart-shopping"></i>
      <span>{{localize "BENEOS.Cloud.Footer.Webshop"}}</span>
    </button>
    <button type="button"
            class="bc-footer-button bc-footer-link bc-footer-button-patreon"
            data-action="openExternal" data-href="{{patreonUrl}}"
            data-tooltip="{{localize 'BENEOS.Cloud.Footer.PatreonTooltip'}}">
      <i class="fa-brands fa-patreon"></i>
      <span>{{localize "BENEOS.Cloud.Footer.Patreon"}}</span>
    </button>
    {{!-- Visual divider — splits the "leaves the app" external link
         cluster (Discord / Webshop / Patreon) from the in-app Settings
         action that lives right after it. --}}
    <span class="bc-footer-divider" aria-hidden="true"></span>
    {{!-- Settings button — opens BeneosCloudSettingsV2 modal. Uses
         fa-sliders to differentiate from the existing fa-gear in the
         AccountSettings button on the left. Intentionally NOT carrying
         the .bc-footer-link class — Settings is an in-app primary
         action and should hold its full brightness even at rest, while
         the external links next to it stay dimmed until hover. --}}
    <button type="button"
            class="bc-footer-button bc-footer-button-settings"
            data-action="openSettings"
            data-tooltip="{{localize 'BENEOS.Cloud.Footer.SettingsTooltip'}}">
      <i class="fa-solid fa-sliders"></i>
      <span>{{localize "BENEOS.Cloud.Footer.Settings"}}</span>
    </button>
  </div>
</footer>
</div>
