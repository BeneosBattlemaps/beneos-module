<div class="seg-radio">
  <button type="button"
          class="{{#if (eq value "close")}}active{{/if}}"
          data-action="lgc-set-distance"
          data-value="close">{{i18nClose}}</button>
  <button type="button"
          class="{{#if (eq value "mid")}}active{{/if}}"
          data-action="lgc-set-distance"
          data-value="mid">{{i18nMid}}</button>
  <button type="button"
          class="{{#if (eq value "far")}}active{{/if}}"
          data-action="lgc-set-distance"
          data-value="far">{{i18nFar}}</button>
</div>
