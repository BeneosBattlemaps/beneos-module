<div class="codex-subpage">
  <div class="subpage-tabbar">
    <button class="subpage-back" data-action="go-hub">{{localize "BENEOS.Codex.BackToHub"}}</button>
    {{#each itemSubTabs}}
      <button class="subpage-tab {{#if active}}active{{/if}}" data-action="go-tab" data-tab="{{id}}">{{localize label}}</button>
    {{/each}}
  </div>
  <div class="subpage-lead">{{localize itemSubLead}}</div>

  <div class="beneos-codex-hint">
    <span>{{localize "BENEOS.Access.TokenContentLabel"}}</span>
    {{#unless hasTokenAccess}}
      <a class="beneos-codex-hint-join" href="{{joinPatreonUrl}}" target="_blank" rel="noopener noreferrer">
        <i class="fa-brands fa-patreon" aria-hidden="true"></i>
        <span>{{localize "BENEOS.Patreon.JoinPatron"}}</span>
      </a>
    {{/unless}}
  </div>

  {{#if (eq itemTab "origins")}}
    {{#if detail}}
      {{> "beneos-codex/item-detail" detail=detail}}
    {{else}}
      <div class="item-origins-layout">
        {{> "beneos-codex/item-concept-rail" mechanicRules=mechanicRules}}
        {{> "beneos-codex/item-gallery" gallery=gallery}}
      </div>
    {{/if}}
  {{else if (eq itemTab "loot")}}
    <div class="codex-embed-host" data-embed="loot"></div>
  {{else if (eq itemTab "shop")}}
    <div class="codex-embed-host" data-embed="shop"></div>
  {{else if (eq itemTab "forge")}}
    <div class="codex-embed-host" data-embed="forge"></div>
  {{else}}
    <div class="generator-pane">
      <h2>{{localize "BENEOS.Codex.HubCard.Items.Title"}} <span class="hub-wip">{{localize "BENEOS.Codex.ComingSoon"}}</span></h2>
      <p>{{localize "BENEOS.Codex.ItemSubLead.Forge"}}</p>
    </div>
  {{/if}}
</div>
