<div class="codex-hub">
  <div class="hub-hero">
    <div class="eyebrow">{{localize "BENEOS.Codex.HubBrand"}}</div>
    <p>{{localize "BENEOS.Codex.HubLead"}}</p>
  </div>

  <div class="codex-hub-grid">

    <button class="codex-hub-card" data-action="go-route" data-route="creatures"
            style="--card-glow:transparent;--card-border:var(--bc-border);--card-ink:var(--bc-text);">
      <div class="card-body">
        <div class="card-eyebrow">{{localize "BENEOS.Codex.Tabs.Creatures"}}</div>
        <h3>{{localize "BENEOS.Codex.HubCard.Creatures.Title"}}</h3>
        <p>{{localize "BENEOS.Codex.HubCard.Creatures.Desc"}}</p>
      </div>
    </button>

    <button class="codex-hub-card" data-action="go-route" data-route="items"
            style="--card-glow:transparent;--card-border:var(--bc-border);--card-ink:var(--bc-text);">
      <div class="card-body">
        <div class="card-eyebrow">{{localize "BENEOS.Codex.Tabs.Items"}}</div>
        <h3>{{localize "BENEOS.Codex.HubCard.Items.Title"}}</h3>
        <p>{{localize "BENEOS.Codex.HubCard.Items.Desc"}}</p>
      </div>
    </button>

    <button class="codex-hub-card wip" data-action="go-route" data-route="adventures"
            style="--card-glow:transparent;--card-border:var(--bc-border);--card-ink:var(--bc-text);">
      <div class="card-body">
        <div class="card-eyebrow">{{localize "BENEOS.Codex.Tabs.Adventures"}} <span class="wip-tag">{{localize "BENEOS.Codex.WIP"}}</span></div>
        <h3>{{localize "BENEOS.Codex.HubCard.Adventures.Title"}}</h3>
        <p>{{localize "BENEOS.Codex.HubCard.Adventures.Desc"}}</p>
      </div>
    </button>

    <button class="codex-hub-card wip" data-action="go-route" data-route="spells"
            style="--card-glow:transparent;--card-border:var(--bc-border);--card-ink:var(--bc-text);">
      <div class="card-body">
        <div class="card-eyebrow">{{localize "BENEOS.Codex.Tabs.Spells"}} <span class="wip-tag">{{localize "BENEOS.Codex.WIP"}}</span></div>
        <h3>{{localize "BENEOS.Codex.HubCard.Spells.Title"}}</h3>
        <p>{{localize "BENEOS.Codex.HubCard.Spells.Desc"}}</p>
      </div>
    </button>

    <button class="codex-hub-card wip" data-action="go-route" data-route="world"
            style="--card-glow:transparent;--card-border:var(--bc-border);--card-ink:var(--bc-text);">
      <div class="card-body">
        <div class="card-eyebrow">{{localize "BENEOS.Codex.Tabs.World"}} <span class="wip-tag">{{localize "BENEOS.Codex.WIP"}}</span></div>
        <h3>{{localize "BENEOS.Codex.HubCard.World.Title"}}</h3>
        <p>{{localize "BENEOS.Codex.HubCard.World.Desc"}}</p>
      </div>
    </button>

  </div>
</div>
