{{!-- Tactical Guide tab — Welle 4c: horizontal sub-tab strip + full-width
     active card. Empty sub-cards are hidden from the strip so creature-
     specific layouts emerge naturally. --}}
{{#unless data.tactical.anyContent}}
  {{> "modules/beneos-module/templates/codex/parts/partials/empty-section.hbs" section="tactical" isGM=isGM readonly=readonly}}
{{else}}
  <nav class="bc-tactical-sub-tabs" role="tablist">
    {{#each visibleTacticalSubs}}
      <button type="button"
              class="bc-tactical-sub-tab {{#if (eq key ../activeTacticalSub)}}is-active{{/if}}"
              data-action="switchTacticalSub"
              data-sub="{{key}}"
              role="tab"
              aria-selected="{{#if (eq key ../activeTacticalSub)}}true{{else}}false{{/if}}">
        <img src="modules/beneos-module/icons/guide_{{key}}.webp" alt="">
        <span>{{localize label}}</span>
      </button>
    {{/each}}
  </nav>

  {{#if activeTacticalSub}}
    <article class="bc-tactical-content bc-tactical-card--{{activeTacticalSub}}"
             data-edit-section="tactical.{{activeTacticalSub}}">
      <header>
        <img src="modules/beneos-module/icons/guide_{{activeTacticalSub}}.webp" alt="" class="bc-tactical-content-icon">
        <h3>{{localize activeTacticalLabel}}</h3>
        {{> "modules/beneos-module/templates/codex/parts/partials/source-chip.hbs" source=activeTacticalSource}}
        {{#if isGM}}
          <button type="button" class="bc-icon-btn"
                  data-action="toggleEdit" data-section="tactical.{{activeTacticalSub}}"
                  {{#if readonly}}disabled{{/if}}
                  data-tooltip="{{localize 'BENEOS.CreatureCodex.Edit'}}">
            <i class="fa-solid fa-pen"></i>
          </button>
        {{/if}}
      </header>
      <div class="bc-rich-html">{{{activeTacticalValue}}}</div>
    </article>
  {{/if}}
{{/unless}}
