{{!-- Foreshadowing — Welle 5: numbered cards (01, 02, …) with title,
     descriptive text, and check-box (DC + skill chips + optional
     modifier + result). --}}
<div class="cdx-section">
  <header class="cdx-h">
    <h2>{{localize "BENEOS.CreatureCodex.Foreshadowing.Title"}}</h2>
    <p>{{localize "BENEOS.CreatureCodex.Foreshadowing.Hint"}}</p>
  </header>

  {{#if data.foreshadowing.length}}
    <div class="cdx-foreshadow">
      {{#each data.foreshadowing}}
        <article class="cdx-foresee" style="--stagger-index:{{@index}}">
          <div class="cdx-foresee-num">{{padTwo (add @index 1)}}</div>
          <div class="cdx-foresee-body">
            <h3 class="cdx-foresee-title">{{title}}</h3>
            <p class="cdx-foresee-text">{{text}}</p>
            {{#if check}}
              <div class="cdx-check">
                <div class="cdx-check-header">
                  <span class="cdx-dc">DC {{check.dc}}</span>
                  {{#each check.skills}}<span class="cdx-skill">{{this}}</span>{{/each}}
                  {{#if check.modifier}}<span class="cdx-mod">({{check.modifier}})</span>{{/if}}
                </div>
                <p class="cdx-check-result">{{check.result}}</p>
              </div>
            {{/if}}
          </div>
        </article>
      {{/each}}
    </div>
  {{else}}
    <p class="cdx-empty">{{localize "BENEOS.CreatureCodex.EmptyState.NoSection"}}</p>
  {{/if}}
</div>
