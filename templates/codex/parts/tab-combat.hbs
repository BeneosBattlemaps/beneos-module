{{!-- Combat tab — GM only. Before-combat starter + death prompt.
     Each card carries `data-edit-section` so the editor knows which
     section the pen icon refers to (combatStarter vs deathPrompt). --}}
<section style="display:flex;flex-direction:column;gap:var(--bc-space-4)">

  {{#if (eq data.combatStarter.source "empty")}}
    {{> "modules/beneos-module/templates/codex/parts/partials/empty-section.hbs" section="combatStarter" isGM=isGM readonly=readonly}}
  {{else}}
    <article class="bc-section-card" data-edit-section="combatStarter">
      <header>
        <h3>{{localize "BENEOS.CreatureCodex.Combat.Before"}}</h3>
        {{> "modules/beneos-module/templates/codex/parts/partials/source-chip.hbs" source=data.combatStarter.source}}
        {{#if isGM}}
          <button type="button" class="bc-icon-btn"
                  data-action="toggleEdit" data-section="combatStarter"
                  {{#if readonly}}disabled{{/if}}
                  data-tooltip="{{localize 'BENEOS.CreatureCodex.Edit'}}">
            <i class="fa-solid fa-pen"></i>
          </button>
        {{/if}}
      </header>
      <div class="bc-rich-html">{{{data.combatStarter.value}}}</div>
    </article>
  {{/if}}

  {{#if (eq data.deathPrompt.source "empty")}}
    {{> "modules/beneos-module/templates/codex/parts/partials/empty-section.hbs" section="deathPrompt" isGM=isGM readonly=readonly}}
  {{else}}
    <article class="bc-section-card" data-edit-section="deathPrompt">
      <header>
        <h3>{{localize "BENEOS.CreatureCodex.Combat.Death"}}</h3>
        {{> "modules/beneos-module/templates/codex/parts/partials/source-chip.hbs" source=data.deathPrompt.source}}
        {{#if isGM}}
          <button type="button" class="bc-icon-btn"
                  data-action="toggleEdit" data-section="deathPrompt"
                  {{#if readonly}}disabled{{/if}}
                  data-tooltip="{{localize 'BENEOS.CreatureCodex.Edit'}}">
            <i class="fa-solid fa-pen"></i>
          </button>
        {{/if}}
      </header>
      <div class="bc-rich-html">{{{data.deathPrompt.value}}}</div>
    </article>
  {{/if}}

</section>
