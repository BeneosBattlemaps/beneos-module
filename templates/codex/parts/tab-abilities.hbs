{{!-- Abilities tab — GM only. Card per ability with name + flavor description.
     Welle 4b: per-entry edit/remove + Add-Entry footer. --}}
{{#if (eq data.abilities.source "empty")}}
  {{> "modules/beneos-module/templates/codex/parts/partials/empty-section.hbs" section="abilities" isGM=isGM readonly=readonly}}
{{else}}
  <header style="display:flex;align-items:center;gap:var(--bc-space-2);margin-bottom:var(--bc-space-3)">
    <h2 style="margin:0;font-family:var(--bc-font-display);color:var(--bc-accent-soft);border:none">
      {{localize "BENEOS.CreatureCodex.Abilities.Title"}}
    </h2>
    {{> "modules/beneos-module/templates/codex/parts/partials/source-chip.hbs" source=data.abilities.source}}
  </header>
  <div class="bc-tactical-grid">
    {{#each data.abilities.value}}
      <article class="bc-tactical-card" data-entry-id="{{id}}">
        <header>
          {{#if type}}<span class="bne-chip">{{type}}</span>{{/if}}
          <h3>{{name}}</h3>
          {{#if ../isGM}}
            <span class="bc-entry-actions-inline">
              <button type="button" class="bc-icon-btn"
                      data-action="editEntry" data-section="abilities" data-entry-id="{{id}}"
                      {{#if ../readonly}}disabled{{/if}}
                      data-tooltip="{{localize 'BENEOS.CreatureCodex.EditEntry'}}">
                <i class="fa-solid fa-pen"></i>
              </button>
              <button type="button" class="bc-icon-btn"
                      data-action="removeEntry" data-section="abilities" data-entry-id="{{id}}"
                      {{#if ../readonly}}disabled{{/if}}
                      data-tooltip="{{localize 'BENEOS.CreatureCodex.RemoveEntry'}}">
                <i class="fa-solid fa-trash"></i>
              </button>
            </span>
          {{/if}}
        </header>
        <div class="bc-rich-html">{{{description}}}</div>
      </article>
    {{/each}}
  </div>
  {{#if isGM}}
    <button type="button" class="bc-btn bc-btn-primary bc-add-entry-btn"
            data-action="addEntry" data-section="abilities"
            {{#if readonly}}disabled{{/if}}
            style="margin-top:var(--bc-space-3)">
      <i class="fa-solid fa-plus"></i> {{localize "BENEOS.CreatureCodex.AddEntry"}}
    </button>
  {{/if}}
{{/if}}
