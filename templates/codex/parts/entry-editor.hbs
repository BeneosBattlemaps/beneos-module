{{!-- List-entry editor dialog. Renders one form row per field
     declaration provided by codex-list-editor.mjs:FIELD_SETS. The
     prosemirror slot is a placeholder; the Application mounts the
     element programmatically in _onRender. --}}
<div class="bc-entry-editor">
  {{#each fields}}
    <div class="bc-entry-field" data-field="{{id}}">
      <label for="bc-entry-{{id}}">{{label}}</label>

      {{#if (eq type "text")}}
        <input id="bc-entry-{{id}}" type="text" name="{{id}}" value="{{value}}">
      {{/if}}

      {{#if (eq type "number")}}
        <input id="bc-entry-{{id}}" type="number" name="{{id}}" value="{{value}}" min="0" step="1">
      {{/if}}

      {{#if (eq type "csv")}}
        <input id="bc-entry-{{id}}" type="text" name="{{id}}" value="{{valueCsv}}" placeholder="History, Insight, Arcana">
      {{/if}}

      {{#if (eq type "select")}}
        <select id="bc-entry-{{id}}" name="{{id}}">
          {{#each options}}
            <option value="{{this}}" {{#if (eq this ../value)}}selected{{/if}}>{{this}}</option>
          {{/each}}
        </select>
      {{/if}}

      {{#if (eq type "prosemirror")}}
        <div class="bc-prose-slot" data-prose-for="{{id}}"></div>
      {{/if}}
    </div>
  {{/each}}

  <footer class="bc-entry-actions">
    <button type="button" class="bc-btn bc-btn-primary" data-action="submit">
      <i class="fa-solid fa-floppy-disk"></i> {{submitLabel}}
    </button>
    <button type="button" class="bc-btn" data-action="cancel">
      {{cancelLabel}}
    </button>
  </footer>
</div>
