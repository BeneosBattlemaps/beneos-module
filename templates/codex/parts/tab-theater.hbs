{{!-- Combat Theater — Welle 5 Master layout. Round counter + First
     appearance read-aloud + Ability prompts with use-counter + Death
     prompt trigger. Logic wires in Welle 5c. --}}
<div class="cdx-section">
  {{!-- Welle 5h: Round-counter toolbar removed per user feedback —
       Foundry already tracks combat rounds. --}}

  <header class="cdx-h">
    <h2>{{localize "BENEOS.CreatureCodex.Theater.FirstAppearance"}}</h2>
    <p>{{localize "BENEOS.CreatureCodex.Theater.FirstAppearanceHint"}}</p>
  </header>
  {{#if data.firstAppearance}}
    <div class="cdx-readable {{#if theater.firstAppRead}}read{{/if}}">
      <blockquote class="cdx-blockquote cdx-blockquote-dramatic">{{data.firstAppearance}}</blockquote>
      <div class="cdx-readable-actions">
        <button type="button" class="cdx-mini-action" data-action="theaterReadFirst">
          <i class="fa-solid fa-play"></i> {{localize "BENEOS.CreatureCodex.Theater.ReadAloud"}}
        </button>
        <button type="button" class="cdx-mini-action {{#if theater.firstAppRead}}on{{/if}}" data-action="theaterToggleFirstRead">
          <i class="fa-solid fa-check"></i>
          {{#if theater.firstAppRead}}{{localize "BENEOS.CreatureCodex.Theater.Used"}}{{else}}{{localize "BENEOS.CreatureCodex.Theater.MarkUsed"}}{{/if}}
        </button>
      </div>
    </div>
  {{else}}
    <p class="cdx-empty">{{localize "BENEOS.CreatureCodex.EmptyState.NoSection"}}</p>
  {{/if}}

  <header class="cdx-h">
    <h2>{{localize "BENEOS.CreatureCodex.Theater.AbilityPrompts"}}</h2>
    <p>{{localize "BENEOS.CreatureCodex.Theater.AbilityPromptsHint"}}</p>
  </header>
  {{#if data.abilityPrompts.length}}
    <div class="cdx-prompts">
      {{#each data.abilityPrompts}}
        {{#with (lookup ../theater.usedAbilities name) as |count|}}{{/with}}
        <article class="cdx-prompt {{#if (lookup ../theater.usedAbilities name)}}used{{/if}}" style="--stagger-index:{{@index}}">
          <header class="cdx-prompt-head">
            <span class="cdx-prompt-marker"></span>
            <h3>{{name}}</h3>
            {{#if (lookup ../theater.usedAbilities name)}}
              <span class="cdx-prompt-count">×{{lookup ../theater.usedAbilities name}}</span>
            {{/if}}
            {{!-- Welle 5h: per-ability read-aloud button removed —
                 the prompt body doesn't read well in TTS form. --}}
          </header>
          <p class="cdx-prompt-text">{{text}}</p>
          <div class="cdx-prompt-actions">
            <button type="button" class="cdx-mini-action primary" data-action="theaterUseAbility" data-name="{{name}}">
              <i class="fa-solid fa-check"></i> {{localize "BENEOS.CreatureCodex.Theater.Use"}}
            </button>
          </div>
        </article>
      {{/each}}
    </div>
  {{else}}
    <p class="cdx-empty">{{localize "BENEOS.CreatureCodex.EmptyState.NoSection"}}</p>
  {{/if}}

  <header class="cdx-h">
    <h2>{{localize "BENEOS.CreatureCodex.Theater.DeathPrompt"}}</h2>
    <p>{{localize "BENEOS.CreatureCodex.Theater.DeathPromptHint"}}</p>
  </header>
  {{#if data.deathPrompt}}
    <blockquote class="cdx-blockquote cdx-blockquote-death">{{data.deathPrompt}}</blockquote>
    <div class="cdx-death-trigger">
      <button type="button" class="cdx-btn cdx-btn-danger" data-action="triggerDeath">
        <i class="fa-solid fa-skull"></i> {{localize "BENEOS.CreatureCodex.Theater.TriggerDeath"}}
      </button>
      <small>{{localize "BENEOS.CreatureCodex.Theater.AutoFireHint"}}</small>
    </div>
  {{else}}
    <p class="cdx-empty">{{localize "BENEOS.CreatureCodex.EmptyState.NoSection"}}</p>
  {{/if}}
</div>
