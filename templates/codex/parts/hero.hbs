{{!-- Hero — Welle 5: full-width banner with sizeTone-derived SVG
     atmospherics + drifting particles + ken-burns zoom. --}}
<header class="cdx-hero"
        style="background: linear-gradient(135deg, {{data.sizeTone.primary}}, {{data.sizeTone.secondary}});">
  <div class="cdx-hero-art">
    <div class="cdx-hero-zoom">
      <svg viewBox="0 0 800 400" preserveAspectRatio="xMidYMid slice" width="100%" height="100%">
        <defs>
          <radialGradient id="cdx-glow-{{data.id}}" cx="0.65" cy="0.35" r="0.55">
            <stop offset="0%"   stop-color="{{data.sizeTone.glow}}" stop-opacity="0.45"/>
            <stop offset="60%"  stop-color="{{data.sizeTone.glow}}" stop-opacity="0.05"/>
            <stop offset="100%" stop-color="{{data.sizeTone.glow}}" stop-opacity="0"/>
          </radialGradient>
          <linearGradient id="cdx-vig-{{data.id}}" x1="0" y1="1" x2="0" y2="0">
            <stop offset="0%"   stop-color="rgba(0,0,0,0.8)"/>
            <stop offset="60%"  stop-color="rgba(0,0,0,0.15)"/>
            <stop offset="100%" stop-color="rgba(0,0,0,0)"/>
          </linearGradient>
        </defs>
        <rect width="800" height="400" fill="url(#cdx-glow-{{data.id}})"/>
        {{!-- distant ridges --}}
        <path d="M0 280 L 80 240 L 140 260 L 220 220 L 280 250 L 360 230 L 420 250 L 480 220 L 560 245 L 640 230 L 720 240 L 800 220 L 800 400 L 0 400 Z" fill="rgba(0,0,0,0.35)"/>
        <path d="M0 320 L 60 295 L 140 315 L 220 290 L 300 310 L 380 295 L 460 315 L 540 295 L 620 310 L 700 295 L 800 310 L 800 400 L 0 400 Z" fill="rgba(0,0,0,0.5)"/>
        {{!-- creature silhouette with portrait initial --}}
        <g transform="translate(560 200)" opacity="0.7">
          <ellipse cx="0" cy="120" rx="120" ry="20" fill="rgba(0,0,0,0.6)"/>
          <path d="M-40 120 L -50 60 L -30 -20 L 0 -50 L 40 -20 L 50 60 L 40 120 Z" fill="rgba(0,0,0,0.7)"/>
          <circle cx="0" cy="-30" r="22" fill="rgba(0,0,0,0.75)"/>
          <text x="0" y="-22" text-anchor="middle" font-size="32"
                fill="{{data.sizeTone.glow}}" fill-opacity="0.5"
                font-family="serif" font-weight="700">{{data.portraitInitial}}</text>
        </g>
        {{!-- drifting particles (CSS-animated) --}}
        <g class="cdx-particles">
          <circle cx="120" cy="50"  r="1.5" fill="rgba(255,240,200,0.85)" style="animation-delay:0s"/>
          <circle cx="240" cy="30"  r="1.0" fill="rgba(255,240,200,0.75)" style="animation-delay:1.2s"/>
          <circle cx="380" cy="60"  r="1.3" fill="rgba(255,240,200,0.8)"  style="animation-delay:2.4s"/>
          <circle cx="180" cy="80"  r="0.8" fill="rgba(255,240,200,0.65)" style="animation-delay:3.6s"/>
          <circle cx="320" cy="100" r="1.1" fill="rgba(255,240,200,0.7)"  style="animation-delay:4.8s"/>
          <circle cx="480" cy="40"  r="1.0" fill="rgba(255,240,200,0.75)" style="animation-delay:0.6s"/>
          <circle cx="80"  cy="120" r="0.7" fill="rgba(255,240,200,0.55)" style="animation-delay:1.8s"/>
          <circle cx="600" cy="70"  r="1.4" fill="rgba(255,240,200,0.8)"  style="animation-delay:3.0s"/>
          <circle cx="720" cy="110" r="0.9" fill="rgba(255,240,200,0.7)"  style="animation-delay:4.2s"/>
          <circle cx="420" cy="160" r="0.6" fill="rgba(255,240,200,0.5)"  style="animation-delay:5.4s"/>
          <circle cx="260" cy="180" r="0.8" fill="rgba(255,240,200,0.6)"  style="animation-delay:0.3s"/>
          <circle cx="560" cy="140" r="1.0" fill="rgba(255,240,200,0.7)"  style="animation-delay:2.1s"/>
        </g>
        <rect width="800" height="400" fill="url(#cdx-vig-{{data.id}})"/>
      </svg>
    </div>
  </div>

  <div class="cdx-hero-body">
    <div class="cdx-hero-meta">
      {{#if data.cr}}<span class="cdx-cr">CR {{data.cr}}</span><span class="cdx-divider"></span>{{/if}}
      <span class="cdx-type">{{data.type}}</span>
      {{#if data.biome}}<span class="cdx-divider"></span><span class="cdx-biome">{{data.biome}}</span>{{/if}}
    </div>
    <h1 class="cdx-name">{{data.name}}</h1>
    <p class="cdx-showcase">{{data.showcase}}</p>
    <div class="cdx-hero-actions">
      <button type="button"
              class="cdx-btn cdx-btn-primary"
              data-action="downloadPdf"
              {{#unless canDownloadPdf}}disabled{{/unless}}>
        <i class="fa-solid fa-download"></i> {{localize "BENEOS.CreatureCodex.DownloadPdf"}}
      </button>
      {{#if data.actorId}}
        <button type="button" class="cdx-btn" data-action="openSheet">
          <i class="fa-solid fa-user"></i> {{localize "BENEOS.CreatureCodex.OpenSheet"}}
        </button>
      {{/if}}
      {{#if data.journalId}}
        <button type="button" class="cdx-btn" data-action="openJournal">
          <i class="fa-solid fa-book"></i> {{localize "BENEOS.CreatureCodex.OpenJournal"}}
        </button>
      {{/if}}
    </div>
  </div>
</header>
