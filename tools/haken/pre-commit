#!/bin/sh
# Pruefstor fuer beneos-module. Angelegt am 2026-10-28 im Zuge von OP-SYS-109.
#
# WARUM ES DIESES TOR GIBT
#
# Dieser Bestand wird an Kunden ausgeliefert und hielt drei Pruefungen mit
# zusammen 82 Pruefsaetzen, die alle gruen laufen, ohne Netz, ohne Foundry und
# ohne Abhaengigkeiten, und die niemand fuhr. Es gab keinen Ort, an dem eine
# haengen konnte: `.git/hooks` trug nur `prepare-commit-msg`.
#
# Zwei der drei kamen in der Wachinventur von OP-SYS-109 gar nicht vor, weil
# ihr Name nicht auf `pruefe-`, `check-`, `audit-` oder `verify-` passt.
# `anker.test.mjs` und `v14-import-bench/unit.mjs` heissen anders und tragen
# 75 der 82 Saetze. Die Inventur nennt diese Luecke selbst unter "nicht
# pruefbar"; hier ist sie eingetreten.
#
# BEWUSST KEIN core.hooksPath
#
# Der haette den vorhandenen `prepare-commit-msg` geraeuschlos getoetet, und
# derselbe Fall hat im Haus schon vier Haken erwischt. `.git/hooks/pre-commit`
# ist nur eine Bruecke auf diese Datei hier, die im Repositorium liegt und
# damit reproduzierbar ist. Beide Haken leben nebeneinander.
#
# WARUM DIE KATALOGPRUEFUNG NUR MANCHMAL LAEUFT
#
# `tools/pruefe-katalog-offline.mjs` braucht gemessen 10,1 Sekunden, weil sie
# die echten Wiederholpausen von 800 und 2500 ms abwartet; das ist ihr
# Gegenstand und kein Mangel. Zehn Sekunden auf JEDEN Commit sind der Preis,
# fuer den ein Tor regelmaessig mit `--no-verify` umgangen wird, und ein Tor,
# das man umgeht, ist keines. Sie laeuft deshalb genau dann, wenn eine der
# zwei Dateien vorgemerkt ist, die sie laedt. Die anderen beiden kosten
# zusammen 0,34 Sekunden und laufen immer. Alle drei stehen seit stre-T-070 in
# `tools/haken/wachen/basis.sh`, wie jede Wache in der Datei ihrer Domaene
# (Abschnitt "Wachen" unten).
#
# WARUM DIE VORGEMERKTE FASSUNG GEPRUEFT WIRD UND NICHT DIE IM BAUM
#
# In diesem Bestand arbeiten mehrere Sitzungen gleichzeitig; am 2026-10-28
# lagen 26 fremde Aenderungen im Arbeitsbaum. `node --check` laeuft deshalb
# gegen `git show :<pfad>`, also gegen das, was wirklich committet wird.
# Fremde halbfertige Arbeit blockiert den eigenen Commit so nicht.
#
# WARUM EINE FEHLENDE PRUEFUNG NICHT IMMER EIN BEFUND IST
#
# Worktrees teilen sich `.git/hooks`, dieses Tor gilt also auch in
# `beneos-module-stream`, `beneos-module-telemetrie` und
# `beneos-module-offline-fix`. Gemessen am 2026-10-28: drei dieser vier
# Arbeitsbaeume tragen die Pruefungen gar nicht, ihre Zweige sind aelter.
# Eine erste Fassung dieses Hakens haette dort JEDEN Commit mit drei
# "fehlt"-Befunden blockiert, und in `stream-beta` arbeiten andere
# Sitzungen.
#
# Der Unterschied, der zaehlt, ist nicht "liegt die Datei da", sondern
# "kennt HEAD sie". Kennt HEAD die Pruefung und die Datei fehlt, hat sie
# jemand entfernt, und das ist ein Befund. Kennt HEAD sie nicht, ist es ein
# anderer Zweig, und dann ist Schweigen richtig.
#
# ZWEI BASH-FALLEN, DIE HIER BEWUSST VERMIEDEN SIND
#
# `$?` nach `if ! befehl` traegt den Wert des negierten Ausdrucks und ist
# immer 0. Und eine `while`-Schleife hinter einer Pipeline laeuft in einer
# Subshell; ein dort gesetzter Zaehler ist danach wieder leer. Die Liste der
# vorgemerkten Dateien geht deshalb ueber eine Datei und nicht ueber ein Rohr.
#
# Umgehen im Notfall: git commit --no-verify

set -u

WURZEL=$(git rev-parse --show-toplevel) || exit 1
cd "$WURZEL" || exit 1

TMP=$(mktemp -d) || exit 1
aufraeumen() { rm -rf "$TMP"; }
trap aufraeumen EXIT

ROT=0

meld() { printf '%s\n' "$*" >&2; }

if ! command -v node >/dev/null 2>&1; then
  meld ""
  meld "pre-commit: node nicht gefunden, das Tor kann nicht messen."
  meld "Ein Tor, das ungeprueft durchlaesst, ist keines, deshalb bricht es ab."
  meld "Bewusst umgehen: git commit --no-verify"
  meld ""
  exit 1
fi

# ---------------------------------------------------------------- Syntax -----
git diff --cached --name-only --diff-filter=ACM -- '*.js' '*.mjs' '*.cjs' \
  > "$TMP/vorgemerkt" 2>/dev/null

# IN DER FORM, IN DER FOUNDRY SIE LAEDT (Nachtrag stre-T-157, Kalt-Review
# W1). Node liest eine `.js` ohne import und export als CommonJS; Foundry
# laedt sie als Modul, wenn sie unter `esmodules` steht oder von dort
# importiert wird. Ein Fehler, den nur das Modulziel kennt, etwa ein doppelter
# Parametername, kam so durch. `ladeform.mjs` nennt die Modulmenge aus der
# vorgemerkten module.json; eine `.js` daraus wird als `.mjs` geprueft, alles
# andere wie bisher. Ist module.json nicht lesbar, ist die Form unbekannt,
# und das sperrt.
: > "$TMP/modulmenge"
if grep -q '^scripts/.*\.js$' "$TMP/vorgemerkt"; then
  if ! node tools/haken/ladeform.mjs > "$TMP/modulmenge" 2>"$TMP/fehler"; then
    meld ""
    meld "pre-commit: ROT  Ladeform unbekannt, die Syntax der .js unter scripts/ ist nicht pruefbar"
    sed -n '1,6p' "$TMP/fehler" >&2
    ROT=$((ROT + 1))
  fi
fi

ANZ_SYNTAX=0
while IFS= read -r pfad; do
  [ -n "$pfad" ] || continue
  ziel="$TMP/$(printf '%s' "$pfad" | tr '/' '_')"
  case "$pfad" in
    *.js) grep -qxF "$pfad" "$TMP/modulmenge" && ziel="$ziel.mjs" ;;
  esac
  if ! git show ":$pfad" > "$ziel" 2>/dev/null; then
    continue
  fi
  ANZ_SYNTAX=$((ANZ_SYNTAX + 1))
  if ! node --check "$ziel" 2>"$TMP/fehler"; then
    meld ""
    meld "pre-commit: Syntaxfehler in der VORGEMERKTEN Fassung von $pfad"
    sed -n '1,6p' "$TMP/fehler" >&2
    ROT=$((ROT + 1))
  fi
done < "$TMP/vorgemerkt"

[ "$ANZ_SYNTAX" -gt 0 ] && meld "pre-commit: node --check ueber $ANZ_SYNTAX vorgemerkte Datei(en)"

# ------------------------------------------------------------- Pruefungen ----
fahre() {
  datei=$1
  name=$2
  if [ ! -f "$datei" ]; then
    if git cat-file -e "HEAD:$datei" 2>/dev/null; then
      meld "pre-commit: $name fehlt im Arbeitsbaum, HEAD kennt sie aber ($datei)"
      ROT=$((ROT + 1))
    fi
    # Kennt HEAD sie nicht, ist dies ein Zweig ohne diese Pruefung. Kein Befund.
    return
  fi
  if node "$datei" > "$TMP/lauf" 2>&1; then
    meld "pre-commit: ok  $name"
  else
    meld ""
    meld "pre-commit: ROT  $name"
    tail -n 25 "$TMP/lauf" >&2
    ROT=$((ROT + 1))
  fi
}

# Wie `fahre`, aber fuer eine Bench, die DREI Austritte kennt. Austritt 2
# heisst "nicht messbar", etwa weil auf diesem Rechner keine Foundry liegt.
# Das ist kein Befund und darf keinen Commit blockieren; es wird gemeldet,
# damit niemand die Deckung fuer gegeben haelt. Nur Austritt 1 ist rot.
#
# DIE BENCH LAEUFT GEGEN DEN INDEX, NICHT GEGEN DIE PLATTE (stre-T-157). Sie
# liest den ganzen Ordner `scripts`; bis dahin sah sie die Platte. Ein
# vorgemerkter Fehler bei sauberer Platte rutschte durch, und eine fremde
# unverfolgte Datei sperrte einen sauberen Commit. Darum werden `scripts`
# und der Ordner der Bench aus dem Index nach `$TMP/index` gelegt, und die
# Bench laeuft von dort. Sie liest relativ zu ihrer eigenen Lage, die
# Indexkopie ist also ihre Wurzel. Die Benches selbst lesen weiter die
# Platte, denn `tools/bench-sabotagen.mjs` faehrt sie in Kopien ohne Git.
fahre_weich() {
  datei=$1
  name=$2
  shift 2
  if ! git cat-file -e ":$datei" 2>/dev/null; then
    if git cat-file -e "HEAD:$datei" 2>/dev/null; then
      meld "pre-commit: $name fehlt im Index, HEAD kennt sie aber"
      ROT=$((ROT + 1))
    fi
    return
  fi
  rm -rf "$TMP/index"
  # Ueber eine Datei, nicht ueber ein Rohr: sh kennt kein pipefail, und eine
  # unvollstaendige Indexkopie (etwa ein Eintrag mit skip-worktree) liesse die
  # Bench sonst still eine Teilmenge lesen.
  #
  # Weitere Pfade hinter dem Namen kommen mit in die Indexkopie, etwa die
  # gemeinsame Ortsliste tools/foundry-orte.mjs (stre-T-019). Fehlt einer,
  # bricht die Bench beim Laden ab und der Satz wird rot, nicht gruen.
  if ! git ls-files -z -- scripts "$(dirname "$datei")" "$@" > "$TMP/indexliste" \
     || ! git checkout-index -z --stdin --ignore-skip-worktree-bits \
          --prefix="$TMP/index/" < "$TMP/indexliste" 2>"$TMP/fehler"
  then
    meld ""
    meld "pre-commit: ROT  $name (Indexkopie unvollstaendig)"
    sed -n '1,6p' "$TMP/fehler" >&2
    ROT=$((ROT + 1))
    return
  fi
  node "$TMP/index/$datei" > "$TMP/lauf" 2>&1
  werte_aus "$?" "$name"
}

# Liest den Austritt eines Satzes mit DREI Austritten: 0 ok, 2 nicht
# gemessen (kein Befund, gemeldet), sonst ROT. Die Ausgabe liegt in $TMP/lauf.
werte_aus() {
  code=$1
  name=$2
  if [ "$code" -eq 0 ]; then
    meld "pre-commit: ok  $name"
  elif [ "$code" -eq 2 ]; then
    meld "pre-commit: NICHT GEMESSEN  $name"
    tail -n 3 "$TMP/lauf" >&2
  else
    meld ""
    meld "pre-commit: ROT  $name"
    tail -n 25 "$TMP/lauf" >&2
    ROT=$((ROT + 1))
  fi
}

# ----------------------------------------------------------------- Wachen ---
# DIE WACHEN STEHEN JE DOMAENE IN EINER EIGENEN DATEI (stre-T-070), unter
# `tools/haken/wachen/<domaene>.sh`. Bis dahin standen sie alle hier, und jede
# neue Wache war ein Edit an dieser einen Datei; beim Trennen von Commits fuer
# einen Push hing jeder Schnitt an ihr. Dieser Kern faehrt selbst keine Wache.
# Eine neue Domaene ist eine neue Datei, eine Liste der Domaenen gibt es nicht.
#
# GELADEN WIRD DIE VORGEMERKTE FASSUNG, aus demselben Grund wie bei der Syntax
# oben. Die Liste kommt aus dem Index, eine unverfolgte Datei laeuft also nie,
# und von einer nur auf der Platte geaenderten Datei laeuft die vorgemerkte.
# Die Reihenfolge ist die des Index, also nach Namen.
#
# EINE KAPUTTE WACHENDATEI LAEUFT GAR NICHT AN. `sh -n` prueft sie vor dem
# Laden. Ohne das liefe sie bis zum Fehler, die Wachen davor waeren gefahren,
# die dahinter still nicht, und der Haken koennte gruen enden.
#
# KENNT HEAD EINE WACHENDATEI UND DER INDEX NICHT, IST DAS ROT. Dann hat
# jemand eine ganze Domaene aus dem Tor genommen, geloescht oder mit
# `git rm --cached`. Dieselbe Regel wie bei `fahre`: was HEAD kennt, darf
# nicht still verschwinden.
#
# Die Wachendateien lesen nichts von der Standardeingabe; die Schleife liest
# trotzdem ueber Kanal 3, damit eine Wache, die es doch tut, die Liste nicht
# leer liest. Die Variablen des Laders heissen `wache_*`, keine Wache benutzt
# den Namen.
if ! git ls-files -- 'tools/haken/wachen/*.sh' > "$TMP/wachen-index" 2>"$TMP/fehler"; then
  meld ""
  meld "pre-commit: ROT  Liste der Wachendateien nicht lesbar"
  sed -n '1,6p' "$TMP/fehler" >&2
  ROT=$((ROT + 1))
fi
: > "$TMP/wachen-head"
if git rev-parse -q --verify HEAD > /dev/null 2>&1; then
  git ls-tree -r --name-only HEAD -- tools/haken/wachen/ > "$TMP/wachen-head" 2>/dev/null
fi
while IFS= read -r wache_pfad; do
  case "$wache_pfad" in
    *.sh) ;;
    *) continue ;;
  esac
  if ! grep -qxF "$wache_pfad" "$TMP/wachen-index"; then
    meld ""
    meld "pre-commit: ROT  $wache_pfad fehlt im Index, HEAD kennt sie aber"
    ROT=$((ROT + 1))
  fi
done < "$TMP/wachen-head"

wache_nr=0
while IFS= read -r wache_pfad <&3; do
  [ -n "$wache_pfad" ] || continue
  wache_nr=$((wache_nr + 1))
  wache_ziel="$TMP/wache-$wache_nr.sh"
  if ! git show ":$wache_pfad" > "$wache_ziel" 2>"$TMP/fehler"; then
    meld ""
    meld "pre-commit: ROT  Wachendatei $wache_pfad nicht aus dem Index lesbar"
    sed -n '1,6p' "$TMP/fehler" >&2
    ROT=$((ROT + 1))
    continue
  fi
  if ! sh -n "$wache_ziel" 2>"$TMP/fehler"; then
    meld ""
    meld "pre-commit: ROT  Syntaxfehler in der Wachendatei $wache_pfad"
    sed -n '1,6p' "$TMP/fehler" >&2
    ROT=$((ROT + 1))
    continue
  fi
  meld "pre-commit: Wachen aus $wache_pfad"
  . "$wache_ziel"
done 3< "$TMP/wachen-index"

# ----------------------------------------------------------------- Ausgang ---
if [ "$ROT" -gt 0 ]; then
  meld ""
  meld "pre-commit: $ROT Befund(e), Commit abgebrochen."
  meld "Bewusst umgehen: git commit --no-verify"
  meld ""
  exit 1
fi

exit 0
