#!/bin/sh
# Huelle des Kennungsriegels (stre-T-047), Regel in commit-msg.mjs.
#
# Diese Huelle ist die EINZIGE Stelle, die entscheidet, ob der Riegel gilt:
# nur wenn die vorgemerkte module.json das Manifest von stream-beta traegt.
# Erkannt am Inhalt, nicht an der Geschichte: nach einem Freigabe-Merge in main
# steht auf main das main-Manifest, auf stream-beta weiter das Beta-Manifest.
# Dieselbe Marke haelt der Push-Riegel (S2 in pre-push.mjs). Ohne module.json
# im Index (erster Commit) gilt der Riegel nicht.
#
# git setzt fuer den Haken GIT_INDEX_FILE, `git show :module.json` liest also
# den Index, der committet wird.
MARKE='BeneosBattlemaps/beneos-module/stream-beta/module.json'
if ! git show :module.json 2>/dev/null | grep -qF "$MARKE"; then
  exit 0
fi
if ! command -v node >/dev/null 2>&1; then
  echo "commit-msg: node fehlt, der Betreff ist nicht pruefbar und der Commit bleibt gesperrt (stre-T-047)" >&2
  exit 1
fi
# MERGE_HEAD als DATEI des Arbeitsbaums, ueber --git-path: im verknuepften
# Arbeitsbaum liegt sie in .git/worktrees/<name>/. Nicht ueber
# `rev-parse --verify`: das loest auch eine Marke namens MERGE_HEAD auf, und
# jeder Commit galte als Merge (Kalt-Review Worker-Riegel, nachgestellt hier).
MERGE=0
if [ -f "$(git rev-parse --git-path MERGE_HEAD)" ]; then
  MERGE=1
fi
# Ob git Rautenzeilen wegraeumt, entscheiden sein Cleanup-Modus und das
# wirksame Kommentarzeichen, nicht allein der Editor (raeumtRauten in der
# Regel). core.commentChar und core.commentString sind fuer git dieselbe
# Einstellung, der zuletzt gesetzte Eintrag gilt; deshalb die letzte Zeile von
# --get-regexp statt beider Werte aneinander. Das Kommandozeilenflag --cleanup
# sieht ein Haken nicht.
CLEANUP=$(git config --get commit.cleanup 2>/dev/null)
KOMMENTAR=$(git config --get-regexp '^core\.comment(char|string)$' 2>/dev/null | tail -n 1 | cut -d' ' -f2-)
BENEOS_IST_MERGE=$MERGE BENEOS_CLEANUP=$CLEANUP BENEOS_KOMMENTAR=$KOMMENTAR node "$(dirname "$0")/commit-msg.mjs" "$@"
